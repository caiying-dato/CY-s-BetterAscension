# 构建输出
bin/
obj/
out/

# Godot 生成的中间产物
.godot/

# 本机专属路径配置（换机器时各人自己写）
local.props
*.user

# NuGet 还原目录
packages/

# 发布打包的暂存目录
release/_stage/

# ─────────────────────────────────────────────────────────────
# 刻意**保留在版本控制**里的目录（不要加进来）：
#
#   dist/     模组构建产物。保留它，模组从游戏里卸载后可以不重新编译就装回去。
#   release/  发布包。保留它，方便直接上传 GitHub Releases 而不必重跑构建。
#
# ─────────────────────────────────────────────────────────────
